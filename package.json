{
  "type": "module",
  "name": "audio-grid",
  "version": "1.0.0",
  "author": "Dambraw",
  "main": "index.js",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "execa": "^5.1.1",
    "express": "^4.18.2",
    "get-audio-duration": "^4.0.1",
    "get-port": "^5.1.1",
    "got": "^11.8.2",
    "unique-string": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-packager": "^17.1.2"
  },
  "scripts": {
    "start": "electron index.js --no-sandbox",
    "build-ubuntu": "electron-packager . AudioGrid --overwrite --platform=linux --icon=AudioGrid.ico --prune=true --out=release-build-ubuntu --ignore=\"release-build-ubuntu|release-build-windows|release-builds\"",
    "build-windows": "electron-packager . AudioGrid --overwrite --platform=win32 --arch=x64 --icon=AudioGrid.ico --prune=true --out=release-build-windows --ignore=\"release-build-ubuntu|release-build-windows|release-builds\""
  }
}
